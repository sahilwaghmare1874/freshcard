# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=freshcart
DB_PORT=3306

# JWT Configuration
JWT_SECRET=freshcart_dev_secret_2025_change_in_production_abc123xyz
JWT_EXPIRE=7d

# Stripe Configuration (Test Mode - Placeholders)
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret

# Email Configuration (Optional - for password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=FreshCart <noreply@freshcart.com>

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5500

# Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=server/uploads/products
